local.file_match "docker_logs" {
  path_targets = [{
    __path__ = "/var/lib/docker/containers/*/*-json.log",
    job      = "docker",
    host     = "trader-helper",
  }]

  sync_period = "5s"
}

loki.source.file "docker_logs" {
  targets    = local.file_match.docker_logs.targets
  forward_to = [loki.process.docker.receiver]
}

loki.process "docker" {
  stage.docker {}

  // A new collector initially sees the full Docker log history. Loki only
  // needs recent records, and subsequent offsets persist in alloy-data.
  stage.drop {
    older_than          = "24h"
    drop_counter_reason = "too_old"
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
