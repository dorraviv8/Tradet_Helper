APP_USERNAME=trader
APP_PASSWORD=replace-with-a-long-random-password
GRAFANA_ADMIN_USER=trader
GRAFANA_ADMIN_PASSWORD=replace-with-a-different-long-random-password
APP_PORT=5173
# Required for the production Caddy profile. Point this DNS name at the VM first.
PUBLIC_HOST=trader.example.com
# Yahoo works in Docker and does not require a desktop application.
DATA_PROVIDER=yahoo
# Optional. Enables delayed exact QQQ option-contract candidates from Market Data.
# Without this token, the app still shows strike, delta, and DTE guidance.
MARKETDATA_TOKEN=

# Optional incident notifications. Paste an incoming webhook from Slack, Discord, or Google Chat.
# The app opens an incident after three consecutive monitor checks and posts one recovery message.
ALERT_WEBHOOK_URL=
MONITOR_INTERVAL_SECONDS=60
MONITOR_FAILURE_THRESHOLD=3

# For a local TWS connection, set DATA_PROVIDER=ibkr and run from .venv.
IBKR_HOST=127.0.0.1
IBKR_PORT=7496
IBKR_CLIENT_ID=17
IBKR_REQUIRE_LIVE=true
